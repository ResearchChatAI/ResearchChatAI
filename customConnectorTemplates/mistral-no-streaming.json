{
  "name": "Mistral — No Streaming",
  "description": "Connect directly to the Mistral API without streaming. The full response is returned at once. Each option is a fixed model version, so the model does not change on its own over time.",
  "requiresStreaming": false,
  "fields": [
    {
      "key": "api_key",
      "label": "Mistral API Key",
      "type": "text",
      "placeholder": "your-mistral-api-key",
      "inputType": "password"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "select",
      "options": [
        { "value": "mistral-small-2603", "label": "Mistral Small 4 (mistral-small-2603)" },
        { "value": "mistral-medium-3-5", "label": "Mistral Medium 3.5 (mistral-medium-3-5)" },
        { "value": "mistral-large-2512", "label": "Mistral Large 3 (mistral-large-2512)" },
        { "value": "ministral-14b-2512", "label": "Ministral 3 14B (ministral-14b-2512)" },
        { "value": "ministral-8b-2512", "label": "Ministral 3 8B (ministral-8b-2512)" }
      ],
      "default": "mistral-small-2603"
    }
  ],
  "connector": {
    "version": "1",
    "request": {
      "url": "https://api.mistral.ai/v1/chat/completions",
      "method": "POST",
      "auth": {
        "type": "bearer",
        "token": "{{api_key}}"
      },
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 30000
    },
    "aiPayload": {
      "model": "{{model}}",
      "temperature": 0.7,
      "max_tokens": 1024
    },
    "history": {
      "mode": "array",
      "extractSystem": false
    },
    "response": {
      "resultPath": "$.choices[0].message.content"
    }
  }
}
