{
  "name": "Anthropic Claude — No Streaming",
  "description": "Connect directly to the Anthropic API without streaming. The full response is returned at once. The current Claude models think before they answer, so a reply can take a few seconds longer; the thinking itself is not shown.",
  "requiresStreaming": false,
  "fields": [
    {
      "key": "api_key",
      "label": "Anthropic API Key",
      "type": "text",
      "placeholder": "sk-ant-api03-...",
      "inputType": "password"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "select",
      "options": [
        { "value": "claude-sonnet-5", "label": "Claude Sonnet 5" },
        { "value": "claude-opus-5-5", "label": "Claude Opus 5.5" },
        { "value": "claude-haiku-4-5", "label": "Claude Haiku 4.5" },
        { "value": "claude-opus-4-8", "label": "Claude Opus 4.8 (older model)" },
        { "value": "claude-sonnet-4-6", "label": "Claude Sonnet 4.6 (older model)" }
      ],
      "default": "claude-sonnet-5"
    }
  ],
  "connector": {
    "version": "1",
    "request": {
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "auth": {
        "type": "custom",
        "header": "x-api-key",
        "value": "{{api_key}}"
      },
      "headers": {
        "Content-Type": "application/json",
        "anthropic-version": "2023-06-01",
        "anthropic-dangerous-direct-browser-access": "true"
      },
      "timeoutMs": 120000
    },
    "aiPayload": {
      "model": "{{model}}",
      "system": "{{systemPrompt}}",
      "max_tokens": 16000
    },
    "history": {
      "mode": "array",
      "extractSystem": true,
      "systemParam": "system"
    },
    "response": {
      "resultPath": "$.content[0].text"
    }
  }
}
