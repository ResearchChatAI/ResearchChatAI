{
  "name": "Mistral — Streaming + Reasoning",
  "description": "Connect to the Mistral API with streaming and reasoning switched on (reasoning_effort: high). The model's reasoning arrives before the final answer and appears in a collapsible block (untick 'Hide reasoning in chat' to show it). Only Mistral Small 4 and Medium 3.5 support reasoning.",
  "requiresStreaming": true,
  "fields": [
    {
      "key": "api_key",
      "label": "Mistral API Key",
      "type": "text",
      "placeholder": "your-mistral-api-key",
      "inputType": "password"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "select",
      "options": [
        { "value": "mistral-small-2603", "label": "Mistral Small 4 (mistral-small-2603)" },
        { "value": "mistral-medium-3-5", "label": "Mistral Medium 3.5 (mistral-medium-3-5)" }
      ],
      "default": "mistral-small-2603"
    }
  ],
  "connector": {
    "version": "1",
    "request": {
      "url": "https://api.mistral.ai/v1/chat/completions",
      "method": "POST",
      "auth": {
        "type": "bearer",
        "token": "{{api_key}}"
      },
      "headers": {
        "Content-Type": "application/json",
        "Accept": "text/event-stream"
      },
      "timeoutMs": 120000,
      "stream": true
    },
    "aiPayload": {
      "model": "{{model}}",
      "reasoning_effort": "high",
      "temperature": 0.7,
      "max_tokens": 8192,
      "stream": true
    },
    "history": {
      "mode": "array",
      "extractSystem": false
    },
    "response": {
      "resultPath": "$.choices[0].message.content",
      "stream": {
        "linePrefix": "data:",
        "doneSignal": "[DONE]",
        "extractors": [
          { "tokenPath": "$.choices[0].delta.content" }
        ]
      }
    }
  }
}
