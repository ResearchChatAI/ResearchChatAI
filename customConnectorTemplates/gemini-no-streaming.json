{
  "name": "Google Gemini — No Streaming",
  "description": "Connect to Google Gemini via its OpenAI-compatible endpoint. The full response is returned at once. No temperature is sent: Google recommends leaving it at the default for Gemini 3, and the newest models ignore it.",
  "requiresStreaming": false,
  "fields": [
    {
      "key": "api_key",
      "label": "Gemini API Key",
      "type": "text",
      "placeholder": "your-gemini-api-key",
      "inputType": "password"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "select",
      "options": [
        { "value": "gemini-3.8-flash", "label": "Gemini 3.8 Flash" },
        { "value": "gemini-3.7-flash", "label": "Gemini 3.7 Flash" },
        { "value": "gemini-3.5-flash-lite", "label": "Gemini 3.5 Flash-Lite" },
        { "value": "gemini-3.1-flash-lite", "label": "Gemini 3.1 Flash-Lite" },
        { "value": "gemini-3.1-pro-preview", "label": "Gemini 3.1 Pro (preview)" },
        { "value": "gemini-3-flash-preview", "label": "Gemini 3 Flash (preview, older model)" },
        { "value": "gemini-3.1-flash-lite-preview", "label": "Gemini 3.1 Flash-Lite (preview, older model)" },
        { "value": "gemini-2.5-flash", "label": "Gemini 2.5 Flash (older model, existing Google accounts only)" },
        { "value": "gemini-2.5-flash-lite", "label": "Gemini 2.5 Flash-Lite (older model, existing Google accounts only)" },
        { "value": "gemini-2.5-pro", "label": "Gemini 2.5 Pro (older model, existing Google accounts only)" }
      ],
      "default": "gemini-3.8-flash"
    }
  ],
  "connector": {
    "version": "1",
    "request": {
      "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "method": "POST",
      "auth": {
        "type": "bearer",
        "token": "{{api_key}}"
      },
      "headers": {
        "Content-Type": "application/json"
      },
      "timeoutMs": 120000
    },
    "aiPayload": {
      "model": "{{model}}",
      "reasoning_effort": "low",
      "max_tokens": 8192
    },
    "history": {
      "mode": "array",
      "extractSystem": false
    },
    "response": {
      "resultPath": "$.choices[0].message.content"
    }
  }
}
