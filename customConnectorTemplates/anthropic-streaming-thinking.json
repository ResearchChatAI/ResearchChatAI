{
  "name": "Anthropic Claude — Streaming + Extended Thinking",
  "description": "Claude models with streaming and a summary of the model's thinking. A collapsible 'Thinking' block appears above the response (untick 'Hide reasoning in chat' to show it). The model decides how much to think; Reasoning Effort sets the upper level.",
  "requiresStreaming": true,
  "fields": [
    {
      "key": "api_key",
      "label": "Anthropic API Key",
      "type": "text",
      "placeholder": "sk-ant-api03-...",
      "inputType": "password"
    },
    {
      "key": "model",
      "label": "Model",
      "type": "select",
      "options": [
        { "value": "claude-sonnet-5", "label": "Claude Sonnet 5" },
        { "value": "claude-opus-5-5", "label": "Claude Opus 5.5" },
        { "value": "claude-opus-4-8", "label": "Claude Opus 4.8 (older model)" },
        { "value": "claude-sonnet-4-6", "label": "Claude Sonnet 4.6 (older model)" }
      ],
      "default": "claude-sonnet-5"
    },
    {
      "key": "effort",
      "label": "Reasoning Effort",
      "type": "select",
      "options": [
        { "value": "low", "label": "Low — light reasoning" },
        { "value": "medium", "label": "Medium — moderate reasoning" },
        { "value": "high", "label": "High — deep reasoning" }
      ],
      "default": "medium"
    }
  ],
  "connector": {
    "version": "1",
    "request": {
      "url": "https://api.anthropic.com/v1/messages",
      "method": "POST",
      "auth": {
        "type": "custom",
        "header": "x-api-key",
        "value": "{{api_key}}"
      },
      "headers": {
        "Content-Type": "application/json",
        "anthropic-version": "2023-06-01",
        "anthropic-dangerous-direct-browser-access": "true",
        "Accept": "text/event-stream"
      },
      "timeoutMs": 120000,
      "stream": true
    },
    "aiPayload": {
      "model": "{{model}}",
      "system": "{{systemPrompt}}",
      "max_tokens": 16000,
      "thinking": {
        "type": "adaptive",
        "display": "summarized"
      },
      "output_config": {
        "effort": "{{effort}}"
      },
      "stream": true
    },
    "history": {
      "mode": "array",
      "extractSystem": true,
      "systemParam": "system"
    },
    "response": {
      "resultPath": "$.content[0].text",
      "reasoningPath": "$.content[0].thinking",
      "stream": {
        "linePrefix": "data:",
        "doneSignal": "[DONE]",
        "extractors": [
          {
            "filter": { "$.type": "content_block_delta", "$.delta.type": "text_delta" },
            "tokenPath": "$.delta.text"
          }
        ],
        "reasoningExtractors": [
          {
            "filter": { "$.type": "content_block_delta", "$.delta.type": "thinking_delta" },
            "tokenPath": "$.delta.thinking"
          }
        ]
      }
    }
  }
}
